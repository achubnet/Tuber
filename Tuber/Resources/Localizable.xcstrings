      }
    },
    "Import from YouTube": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт из YouTube"
          }
        }
      }
    },
    "Import subscriptions": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт подписок"
          }
        }
      }
    },
    "A text file with one channel per line: @handle, channel link or ID. Put “-” before a channel to subscribe without showing it in the feed. subscriptions.csv from Google Takeout works too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстовый файл, по одному каналу на строку: @имя, ссылка на канал или ID. «-» перед каналом: подписаться, но не показывать в ленте. Файл subscriptions.csv из Google Takeout тоже подходит."
          }
        }
      }
    },
    "Added: %lld, updated: %lld, not found: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено: %lld, обновлено: %lld, не найдено: %lld"
          }
        }
      }
    },
