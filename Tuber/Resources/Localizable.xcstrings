    "Import subscriptions from YouTube": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт подписок из YouTube"
          }
        }
      }
    },
    "Get subscriptions.csv at takeout.google.com: choose only “YouTube and YouTube Music”, then “subscriptions”. Unzip it in Files and pick the CSV here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачайте subscriptions.csv на takeout.google.com: выберите только «YouTube и YouTube Music», затем «подписки». Распакуйте архив в «Файлах» и выберите CSV здесь."
          }
        }
      }
    },
    "Added channels: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено каналов: %lld"
          }
        }
      }
    },
    "Could not read the file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
